{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hananitsuku-answer",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Candidate models, tried in order. First one that answers wins.
    // 2026-09-07 production check: gemma-4 burns its whole completion budget on reasoning (empty content), so gpt-oss-20b goes first.
    "AI_MODELS": "@cf/openai/gpt-oss-20b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/google/gemma-4-26b-a4b-it",
    // Global cap per UTC day (keeps usage inside the 10,000 Neurons/day free allocation; gpt-oss-20b ~23 neurons/request).
    "DAILY_LIMIT": "400",
    // Per visitor (hashed IP) caps.
    "PER_IP_MINUTE": "6",
    "PER_IP_DAY": "40",
    // Browser origins allowed to call this API (localhost is always allowed).
    "ALLOWED_ORIGINS": "https://yoshihikomizuno.github.io,https://mazareal.co.jp,https://www.mazareal.co.jp"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "QuotaCounter"
      }
    ]
  },
  "exports": {
    "QuotaCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
